# Environment Configuration Example for Backend

# Server Port
PORT=5000

# MongoDB Connection String (Atlas Cloud / Local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/piyushdhara?retryWrites=true&w=majority

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Nodemailer / Email Service (Optional for OTPs & Certificate Delivery)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
